<?xml version="1.0" encoding="utf-8"?>
<!--
    The plate: high-altitude night, the design system's primary app-icon ground.

    A drawable rather than a colour, because the reference plate is a gradient and a flat fill of
    either endpoint loses the thing that makes it read as sky. The angle is the design's own 160°,
    which is to say almost straight down with a slight lean right; a 45° diagonal reads as a UI
    gradient rather than as light falling.

    The whole 108 square is painted even though only the middle 72 is guaranteed visible: the outer
    ring is what the launcher's mask crops into and what it parallaxes across, so a background that
    stopped at the safe zone would show its own edges the moment the user scrolled the home screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="0"
                android:endX="88"
                android:endY="108"
                android:startColor="#101B2F"
                android:endColor="#05090F" />
        </aapt:attr>
    </path>
</vector>
