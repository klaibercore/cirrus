<?xml version="1.0" encoding="utf-8"?>
<!--
    Just the cloud.

    Built from three overlapping billows over a stadium-shaped base rather than one traced outline.
    The union of simple circles is what gives the emoji its soft, even bumps, and each piece stays
    readable at 48dp where a hand-tuned bezier turns to mush.

    The billows are deliberately tucked inside the base's width, so the base's rounded ends define
    the silhouette low down and the billows define it up top. Letting them line up exactly instead
    puts a visible dent in each side where the two arcs cross.

    Everything sits inside the adaptive icon's safe zone — the centre 72dp of 108 — so no launcher
    mask clips a bump off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Flat-bottomed base with fully rounded ends. -->
    <path
        android:fillColor="#F5F3EF"
        android:pathData="M31,58 L77,58 A11,11 0 0,1 77,80 L31,80 A11,11 0 0,1 31,58 Z" />
    <!-- The tall middle billow. -->
    <path
        android:fillColor="#F5F3EF"
        android:pathData="M35,46 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z" />
    <!-- Right shoulder. -->
    <path
        android:fillColor="#F5F3EF"
        android:pathData="M55,55 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 Z" />
    <!-- Left shoulder, the smallest of the three. -->
    <path
        android:fillColor="#F5F3EF"
        android:pathData="M23,57 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z" />
</vector>
