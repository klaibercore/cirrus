<?xml version="1.0" encoding="utf-8"?>
<!--
    The Cirrus mark: three sweeps inside a pair of braces. What comes through the API, and the API
    it comes through.

    This replaces the filled cloud the app shipped with. The cloud was a union of three discs, drawn
    as a silhouette because a silhouette is what survives at 48dp — a sound answer to a question the
    design system now answers differently. Cirrus clouds are the only clouds shaped entirely by
    wind, and their form is a record of a current passing through them, which is also what a token
    stream is. Drawing that current directly says more about what the app does than an outline of
    the thing the current passes through.

    Every coordinate below is on the design system's 24-unit grid, character for character from
    design/cirrus-icons.svg, and the group is what puts that grid on Android's 108 viewport. Quoting
    the numbers rather than re-tracing them is the only thing that keeps this drawing, the
    notification mask and ui/components/CirrusMark.kt the same mark; the last time two of them were
    drawn separately they quietly drifted into different shapes.

    Scale 2.5 puts the ink at 46.4 of the 72-unit safe zone — around 64% of it. That is the number
    with the least room either side of it: the design's own squircle sits at roughly 54%, which here
    leaves the braces too fine to resolve on a low-density screen, and filling the safe zone edge to
    edge leaves a circular mask with nothing to breathe. The gap between a brace and the sweep
    nearest it is 1.6 units at this scale, which is the measurement to check first if the mark ever
    starts looking like a smudge: below about 1.2 the two run together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <!-- The braces, in cirrus blue: structure, and the only blue on the plate. -->
        <path
            android:strokeColor="#6FB4F0"
            android:strokeWidth="1.55"
            android:strokeLineCap="round"
            android:pathData="M7.4,5.2C5.5,5.2 5.8,7.5 5.8,9.6C5.8,11.2 4.5,12 3.5,12C4.5,12 5.8,12.8 5.8,14.4C5.8,16.5 5.5,18.8 7.4,18.8" />
        <path
            android:strokeColor="#6FB4F0"
            android:strokeWidth="1.55"
            android:strokeLineCap="round"
            android:pathData="M16.6,5.2C18.5,5.2 18.2,7.5 18.2,9.6C18.2,11.2 19.5,12 20.5,12C19.5,12 18.2,12.8 18.2,14.4C18.2,16.5 18.5,18.8 16.6,18.8" />
        <!-- The three sweeps, in ice: the content coming through. Top to bottom. -->
        <path
            android:strokeColor="#EEF5FD"
            android:strokeWidth="1.55"
            android:strokeLineCap="round"
            android:pathData="M9.3,10C10.97,8.96 12.92,9.31 14.7,8.2" />
        <path
            android:strokeColor="#EEF5FD"
            android:strokeWidth="1.55"
            android:strokeLineCap="round"
            android:pathData="M8,13.4C10.48,11.89 13.36,12.4 16,10.8" />
        <path
            android:strokeColor="#EEF5FD"
            android:strokeWidth="1.55"
            android:strokeLineCap="round"
            android:pathData="M9.8,15.8C11.16,14.99 12.75,15.26 14.2,14.4" />
    </group>
</vector>
