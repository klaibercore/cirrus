<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar icons are drawn as a mask: only the alpha channel survives, so this is a solid
    silhouette with no detail inside it.

    The viewport stays at 108 even though the icon renders at 24dp, so the geometry is character for
    character the launcher's — the previous version was a separately hand-drawn bezier cloud that
    had quietly drifted into a different shape from the one on the home screen. Sharing the numbers
    is the only way the two stay in agreement.

    The silhouette spans 23.4..84.6 of 108, which leaves roughly 5dp of clear space inside the 24dp
    box — about what the status bar expects.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M33,59.5 L75,59.5 A9.6,9.6 0 0,1 75,78.7 L33,78.7 A9.6,9.6 0 0,1 33,59.5 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M35.4,47 a17.6,17.6 0 1,0 35.2,0 a17.6,17.6 0 1,0 -35.2,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,56 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24.8,57.5 a13.2,13.2 0 1,0 26.4,0 a13.2,13.2 0 1,0 -26.4,0 Z" />
</vector>
